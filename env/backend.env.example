# --- Copy this file to .env and fill in your own values. Never commit .env. ---

# Supabase (database + file storage). From your Supabase project > Settings > API.
SUPABASE_URL=https://xyzcompany.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Secret used to sign login tokens (JWT). Any long random string.
JWT_SECRET=change-me-to-something-long-and-random

# Firebase (push notifications). Path to the service-account JSON you download
# from Firebase Console > Project settings > Service accounts.
# Leave empty until you do the Firebase setup — pushes are skipped meanwhile.
FCM_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Port the server listens on.
PORT=3001

# Where your frontend lives (for CORS). Comma-separated if more than one.
FRONTEND_URL=http://localhost:5173

# Spotify (playlist creation). From developer.spotify.com dashboard.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:3001/api/playlists/spotify/callback

# Google (sign-in + Meet links). From Google Cloud Console > APIs & Services > Credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/voice/google/callback

# 32-byte encryption key for persisted Google and Spotify OAuth tokens (64 hex chars).
OAUTH_ENCRYPTION_KEY=
